# clangd config. Bazel's compile_commands.json lists the compiler as
# cc_wrapper.sh, which clangd cannot introspect for built-in system headers.
# Override it with the real driver so <vector>, <cstdio>, etc. resolve.
CompileFlags:
  Compiler: /usr/bin/clang++

# metal-cpp (Metal.hpp, Foundation.hpp) and the gRPC/abseil trees are umbrella /
# transitive-header libraries. clangd's Include Cleaner misreads that pattern and
# flags umbrella headers as "unused" or demands the sub-headers directly. Turn
# both off so it stops fighting the intended include style.
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

---
# The shim headers must never be parsed with the client's hijack force-include.
# compile_commands.json carries a metal_shim.h entry borrowed from main.cpp's TU
# (which has -include metal/metal_hijack.h). When clangd parses the header as
# the main file, the hijack's own #include of metal_shim.h is skipped as
# self-inclusion, leaving #define MTL MetalShim active BEFORE the header's own
# Metal.hpp include: the real namespace MTL gets rewritten into MetalShim and
# clangd reports a phantom "redefinition of Device". Strip the force-include
# when parsing these headers; the real build is unaffected.
If:
  PathMatch: metal/metal_.*\.h
CompileFlags:
  Remove: [-include]
