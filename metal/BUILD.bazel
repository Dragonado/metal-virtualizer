load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")

# Local vector-add sample: dispatches on the real GPU, no networking involved.
# add.metal is compiled at runtime via newLibrary(source), so it ships as a
# plain data file, not a build step. Under `bazel run` the cwd is the runfiles
# root, so main.cpp loads it as "metal/add.metal".
cc_binary(
    name = "adder",
    srcs = ["main.cpp"],
    copts = [
        "-include",
        "metal/metal_shim.h",
    ],
    data = ["add.metal"],
    deps = [
        ":metal_shim",
        "//third_party/metal-cpp",
    ],
)

cc_library(
    name = "metal_shim",
    hdrs = ["metal_shim.h"],
    deps = ["//third_party/metal-cpp"],
)
