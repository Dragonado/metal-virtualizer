# Formatting rules. Apply with: clang-format -i <file>   (or format-on-save in VS Code)
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
# 0 = don't reflow/rewrap lines; clang-format only fixes indentation & spacing.
# Set to 80/100/120 later if you want enforced line wrapping.
ColumnLimit: 0
