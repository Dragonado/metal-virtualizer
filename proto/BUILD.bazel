load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# 1. The schema. Import path is "proto/metal_remote.proto" (relative to the
#    workspace root), so generated headers use the same metal_remote stem.
proto_library(
    name = "metal_remote_proto",
    srcs = ["metal_remote.proto"],
)

# 2. The generated protobuf message classes and serialization.
cc_proto_library(
    name = "metal_remote_cc_proto",
    deps = [":metal_remote_proto"],
)

# 3. The service base and client stub. grpc_only reuses the message classes
#    above instead of generating them twice.
cc_grpc_library(
    name = "metal_remote_cc_grpc",
    srcs = [":metal_remote_proto"],
    grpc_only = True,
    deps = [":metal_remote_cc_proto"],
)
