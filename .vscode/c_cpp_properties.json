{
  "configurations": [
    {
      "name": "Mac",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "compilerPath": "/usr/bin/clang++",
      "compilerArgs": ["-isystem", "${workspaceFolder}/third_party/metal-cpp"],
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/third_party/metal-cpp"
      ],
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ],
  "version": 4
}
